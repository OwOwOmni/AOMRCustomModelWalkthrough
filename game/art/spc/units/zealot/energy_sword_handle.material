<material>
	<submaterial name="EnergySwordHandle">
		<materialdef name="opaque_lit"></materialdef>
		<parameters>
			<texture name="BaseColor" override="spc\units\zealot\textures\ddt\energysword_diffuse_atlas"></texture>
			<texture name="Normals" override="spc\units\zealot\textures\ddt\energysword_normal_atlas"></texture>
			<texture name="Masks" override="spc\units\zealot\textures\ddt\energysword_ORM_atlas"></texture>
			<float name="Alpha Cutout Threshold" override="0.0100"></float>
		</parameters>
		<permutations variant="0">
			<permutation>ALPHA_CUT_OUT</permutation>
		</permutations>
	</submaterial>
</material>

