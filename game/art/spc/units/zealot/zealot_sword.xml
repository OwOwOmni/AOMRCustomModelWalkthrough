			<tag type="particles" popcornfxname="EnergySwordSlash.pkfx" bone="weapon_r" movewithbone="true" stopwithanim="true" adjustduration="true">0.05</tag>
		</assetreference>
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_attack_e</file>
            <tag type="Attack">0.202</tag>
			<tag type="SpecificSoundSet" checkvisible="1" set="EnergySwordSlash">0.1</tag>
			<tag type="particles" popcornfxname="EnergySwordSlash.pkfx" bone="weapon_r" movewithbone="true" stopwithanim="true" adjustduration="true">0.1</tag>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
	</anim>

    <anim>Throw
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_grenade_throw</file>
			<tag type="Attack">0.433</tag>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
		<attach name="Grenade" attachpoint="weapon_l"></attach>
	</anim>

	<anim>Gore
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_pistol_kick</file>
			<tag type="Attack">0.22</tag>
		</assetreference>
