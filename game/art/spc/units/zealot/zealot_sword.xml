<animfile>
	<attachment>Weapon<include>spc\units\zealot\energy_sword.xml</include>
	</attachment>

	<attachment>Handle<include>spc\units\zealot\energy_sword_handle.xml</include>
	</attachment>

	<attachment>Grenade<include>spc\units\zealot\plasma_grenade.xml</include>
	</attachment>

	<attachment>EnergySwordBladeParticle
		<component>VFXComp
			<assetreference type="TMComposite">
				<file>vfx\glow\energy_sword_blade_comp</file>
			</assetreference>
		</component>
		<anim>Idle<component>VFXComp</component>
		</anim>
	</attachment>

	<component>ModelComp
        <assetreference type="TMModel">
            <file>spc\units\zealot\zealot</file>
        </assetreference>
	</component>

	<anim>Bored
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_bored_patrol_a</file>
		</assetreference>
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_bored_patrol_b</file>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
	</anim>

	<anim>Death
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_dead</file>
			<tag type="SpecificSoundSet" checkvisible="1" set="EliteDeath">0.15</tag>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
	</anim>

	<anim>Birth
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_ready_a</file>
			<tag type="particles" popcornfxname="EnergySwordFlash.pkfx" bone="weapon_r_vfx" 
			movewithbone="true" stopwithanim="true" adjustduration="true">0.478</tag>
			<tag type="particles" popcornfxname="EnergySwordBlade.pkfx" bone="weapon_r_vfx" 
			movewithbone="true" stopwithanim="true" adjustduration="true">0.478</tag>
			<tag type="SpecificSoundSet" checkvisible="1" set="EnergySwordActivate">0.478</tag>
		</assetreference>
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_ready_b</file>
			<tag type="particles" popcornfxname="EnergySwordFlash.pkfx" bone="weapon_r_vfx" 
			movewithbone="true" stopwithanim="true" adjustduration="true">0.359</tag>
			<tag type="particles" popcornfxname="EnergySwordBlade.pkfx" bone="weapon_r_vfx" 
			movewithbone="true" stopwithanim="true" adjustduration="true">0.359</tag>
			<tag type="SpecificSoundSet" checkvisible="1" set="EnergySwordActivate">0.359</tag>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Handle" attachpoint="weapon_r"></attach>
	</anim>

	<anim>Idle
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_idle</file>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
	</anim>

	<anim>Walk_Slow
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_walk</file>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
	</anim>

	<anim>Walk
		<assetreference type="TMAnimation">
			<file>spc\units\zealot\anim\elite_sword_run</file>
		</assetreference>
		<component>ModelComp</component>
		<attach name="Weapon" attachpoint="weapon_r"></attach>
	</anim>

	<anim>Berserk
